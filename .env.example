# 값 없이도 모든 페이지가 데모 모드로 동작합니다. 실제 저장/연동에만 필요합니다.

# Supabase — 대기자 명단, PersonaHub 로그인, SimpleOrder 가게/주문 저장
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키 (절대 NEXT_PUBLIC_ 붙이지 말 것). Square 토큰 저장/조회에 필요
SUPABASE_SERVICE_ROLE_KEY=

# SimpleOrder — Square POS 연동 (선택)
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SimpleOrder — 새 주문 이메일 알림 (선택)
RESEND_API_KEY=
