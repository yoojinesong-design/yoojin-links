# Copy this file to .env and fill in only what you use. .env is git-ignored:
# NEVER commit it or paste keys into a config YAML file.
# 이 파일을 .env 로 복사해서 필요한 값만 채우세요. 키는 절대 공유하지 마세요.

# --- Alpaca (US stocks). Use PAPER keys from https://app.alpaca.markets (Paper account > API Keys).
ALPACA_API_KEY=
# Alpaca secret key, shown only once when you generate the key pair.
ALPACA_SECRET_KEY=

# --- Crypto exchange via ccxt. Only needed for testnet (use_sandbox) or live trading, not for paper.
CCXT_API_KEY=
# Exchange API secret. Create keys with trading permission only, NEVER withdrawal permission.
CCXT_SECRET=
# API passphrase, only for exchanges that use one (e.g. OKX, KuCoin); leave empty otherwise.
CCXT_PASSWORD=

# --- Notifications (optional). Discord or Slack incoming-webhook URL.
NOTIFY_WEBHOOK_URL=
# Telegram bot token from @BotFather. Telegram needs BOTH this and TELEGRAM_CHAT_ID below
# (with only one of them the bot refuses to start, instead of silently sending nothing).
TELEGRAM_BOT_TOKEN=
# Telegram chat id that receives the messages (message your bot, then check getUpdates).
TELEGRAM_CHAT_ID=

# --- REAL-MONEY SWITCH. 실제 돈 거래 스위치 — 신중하게!
# WARNING: uncommenting the next line, together with `mode: live` in your config,
# lets this bot place REAL orders with REAL money, automatically, 24/7. Automated
# trading can lose money quickly, including through bugs, outages and bad fills.
# Only enable it after weeks of paper trading, with money you can afford to lose.
# LIVE_TRADING_CONFIRM=I_ACCEPT_THE_RISK
